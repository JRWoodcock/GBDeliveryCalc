root = true

[*.cs]
# Security rules (CA2100, CA3xxx, CA5xxx) are errors in every build.
dotnet_analyzer_diagnostic.category-Security.severity = warning

# The app is C# only, so VB keyword clashes (ISecretStore.Get/Set) don't apply.
dotnet_diagnostic.CA1716.severity = none

[src/GBDeliveryCalc.Data/Migrations/*.cs]
# Generated by dotnet ef.
generated_code = true
dotnet_diagnostic.CA1861.severity = none

[tests/**.cs]
# xUnit test names use underscores; assertion arrays and LINQ on small lists are fine in tests.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1826.severity = none
