<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF desktop shell. Entry point: App.xaml.cs (composition root). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>GBDeliveryCalc.App</RootNamespace>
    <AssemblyName>GBDeliveryCalc</AssemblyName>
    <AssemblyTitle>GB DeliveryCalc</AssemblyTitle>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon for the .exe, the taskbar and any window without its own Icon. Regenerate with packaging/art/generate_art.py. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\JasonWoodcock.jpg" />
    <Resource Include="Assets\BuyMeACoffeeWhiteButton.png" />
    <Content Include="..\..\LICENSE.txt" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GBDeliveryCalc.Core\GBDeliveryCalc.Core.csproj" />
    <ProjectReference Include="..\GBDeliveryCalc.Data\GBDeliveryCalc.Data.csproj" />
    <ProjectReference Include="..\GBDeliveryCalc.Services\GBDeliveryCalc.Services.csproj" />
    <ProjectReference Include="..\GBDeliveryCalc.Presentation\GBDeliveryCalc.Presentation.csproj" />
  </ItemGroup>
</Project>
