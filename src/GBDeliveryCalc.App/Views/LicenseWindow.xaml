<Window x:Class="GBDeliveryCalc.App.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License"
        Width="760"
        Height="620"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Icon="/Assets/AppIcon.png"
        WindowStartupLocation="CenterOwner">
    <Border Margin="20" BorderBrush="{DynamicResource BorderBrushMuted}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ElevatedBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="6,6,0,0" Padding="18">
                <TextBlock Text="GB DeliveryCalc Free Use, No Redistribution License"
                           Foreground="{DynamicResource HeaderTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <TextBox x:Name="LicenseTextBox" Grid.Row="1" Margin="18" Padding="12" AcceptsReturn="True" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top" />

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrushMuted}" BorderThickness="0,1,0,0" Padding="14" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,6,6">
                <Button Content="Close" IsCancel="True" Width="92" HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</Window>
