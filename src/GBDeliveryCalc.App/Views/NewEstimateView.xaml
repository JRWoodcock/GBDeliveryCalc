<UserControl x:Class="GBDeliveryCalc.App.Views.NewEstimateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.15*" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Integration status banner: anything not live is labelled here. Editing banner below it. -->
    <Border Grid.ColumnSpan="3" Background="{DynamicResource NoticeBackgroundBrush}" BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8"
            Visibility="{Binding IntegrationBanner, Converter={StaticResource NonEmptyToVis}}">
      <TextBlock Text="{Binding IntegrationBanner}" TextWrapping="Wrap" Foreground="{DynamicResource NoticeTextBrush}" />
    </Border>
    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8"
            VerticalAlignment="Bottom" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding EditingText}" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" />
    </Border>

    <!-- ======================= INPUTS ======================= -->
    <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Team and vehicle">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Customer" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Customer name" />
            <TextBlock Grid.Row="1" Text="Team" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Teams}" SelectedItem="{Binding SelectedTeam}" AutomationProperties.Name="Team">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text=" — " />
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource HintBrush}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TeamRatesText}" Style="{StaticResource Hint}" />
            <TextBlock Grid.Row="3" Text="Vehicle" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" DisplayMemberPath="Name" AutomationProperties.Name="Vehicle" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VehicleText}" Style="{StaticResource Hint}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Route">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Start from" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding OriginAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Origin address"
                     ToolTip="Defaults to the shop address from Settings. Change it for this job only if needed." />

            <TextBlock Grid.Row="1" Text="Destination" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DestinationQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Destination search"
                     ToolTip="Street address or place name, e.g. Neshoba Central High School" />
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
              <Button Content="Look up" Command="{Binding SearchAddressCommand}" IsEnabled="{Binding CanLookUpAddress}" />
              <Button Content="Use as typed" Command="{Binding UseTypedAddressCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
            <ListBox MaxHeight="120" Margin="0,2,8,2"
                     ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                     Visibility="{Binding Candidates.Count, Converter={StaticResource NonEmptyToVis}}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FormattedAddress}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Powered by Google" Style="{StaticResource Hint}" Margin="0,0,8,2"
                       Visibility="{Binding ShowPoweredByGoogle, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Job address" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DestinationAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confirmed job address"
                     ToolTip="Editable. Confirm match copies the chosen address here and looks up the route." />
            <Button Grid.Row="3" Grid.Column="2" Content="Confirm match" Command="{Binding ConfirmCandidateCommand}" HorizontalAlignment="Left"
                    ToolTip="Copies the selected address into Job address and fills in miles and drive time." />
            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LookupMessage}" Style="{StaticResource Hint}" />

            <TextBlock Grid.Row="5" Text="Trip" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
              <RadioButton Content="Round trip" IsChecked="{Binding IsRoundTrip}" Margin="0,0,16,0" GroupName="trip" />
              <RadioButton Content="One way" IsChecked="{Binding IsRoundTrip, Converter={StaticResource InverseBool}}" GroupName="trip" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Miles and drive time">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <RadioButton Content="Enter per leg" IsChecked="{Binding ManualIsTripTotal, Converter={StaticResource InverseBool}}" Margin="0,0,16,0" GroupName="basis" />
              <RadioButton Content="Enter trip totals" IsChecked="{Binding ManualIsTripTotal}" GroupName="basis" />
            </StackPanel>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Text="{Binding ManualMilesLabel}" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Column="1" Text="{Binding ManualMilesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manual miles" />
              <TextBlock Grid.Column="2" Text="mi" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="1" Text="{Binding ManualDriveLabel}" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ManualDriveHoursText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manual drive hours" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="h" Style="{StaticResource FieldLabel}" />
              <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ManualDriveMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manual drive minutes" />
              <TextBlock Grid.Row="1" Grid.Column="4" Text="min" Style="{StaticResource FieldLabel}" />
            </Grid>
            <TextBlock Text="{Binding TripSummary}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Text="{Binding RouteSourceText}" Style="{StaticResource Hint}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding RouteIsStale, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Route details changed since these figures were looked up." Style="{StaticResource Warning}" VerticalAlignment="Center" />
              <Button Content="Re-run route lookup" Command="{Binding RunRouteLookupCommand}" Margin="8,4"
                      Visibility="{Binding ShowRerunRouteLookup, Converter={StaticResource BoolToVis}}" />
              <Button Content="Keep these figures" Command="{Binding ConfirmRouteFiguresCommand}" />
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Installation and fuel">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="190" /><ColumnDefinition Width="70" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <TextBlock Text="Installation time" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding InstallHoursText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Installation hours" />
            <TextBlock Grid.Column="2" Text="h" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="3" Text="{Binding InstallMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Installation minutes" />
            <TextBlock Grid.Column="4" Text="min (not affected by trip direction)" Style="{StaticResource FieldLabel}" />

            <TextBlock Grid.Row="2" Text="Fuel price ($/gal)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ManualFuelPriceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Manual fuel price"
                     ToolTip="Manual price override. Leave blank to use today's average for the shop's state, fetched automatically." />
            <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Text="blank = today's state average (automatic)" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Text="{Binding FuelStatusText}" TextWrapping="Wrap" Margin="0,2,0,4">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FuelIsStaleOrMissing}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </GroupBox>

        <GroupBox Header="Labor hours and other costs">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Paid team hours override" Style="{StaticResource FieldLabel}" />
              <TextBox Width="80" Text="{Binding PaidHoursOverrideText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Paid hours override" />
              <TextBlock Text="blank = travel + installation hours" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding LaborHoursText}" Style="{StaticResource Hint}" />
            <TextBlock Text="Other direct job costs" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding OtherCosts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBox Width="240" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cost description" />
                    <TextBox Width="90" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cost amount" />
                    <Button Content="Remove" MinWidth="60"
                            Command="{Binding DataContext.RemoveOtherCostCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Add cost" Command="{Binding AddOtherCostCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <!-- ======================= RESULTS ======================= -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Cost estimate">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding CostLines}" AutomationProperties.Name="Cost lines">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="14" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Total estimated cost" FontWeight="Bold" FontSize="16" />
              <TextBlock Grid.Column="1" Text="{Binding TotalCostText}" FontWeight="Bold" FontSize="16" AutomationProperties.AutomationId="TotalCost"
                         AutomationProperties.Name="{Binding TotalCostText, StringFormat=Total estimated cost {0}}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding CostNotes}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Hint}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding CostIssues, Converter={StaticResource NonEmptyToVis}}">
              <TextBlock Text="Total is incomplete. Needed:" Style="{StaticResource Warning}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding CostIssues}">
                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Warning}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Copy cost estimate" Command="{Binding CopyCostEstimateCommand}" FontWeight="SemiBold" AutomationProperties.AutomationId="CopyCostEstimate" />
              <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" AutomationProperties.Name="Save estimate" />
              <Button Content="New estimate" Command="{Binding StartNewCommand}" />
            </StackPanel>
            <Expander Header="Preview copied text" Margin="0,4,0,0">
              <TextBox Text="{Binding EstimatePreview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
                       HorizontalScrollBarVisibility="Auto" MinHeight="160" />
            </Expander>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding StatusMessage}" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
               AutomationProperties.Name="{Binding StatusMessage, StringFormat=Status: {0}}" />
  </Grid>
</UserControl>
