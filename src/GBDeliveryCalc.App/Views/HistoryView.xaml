<UserControl x:Class="GBDeliveryCalc.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="500" />
      <ColumnDefinition Width="12" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel>
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
        <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
        <TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search estimates" />
      </StackPanel>
      <DataGrid ItemsSource="{Binding Estimates}" SelectedItem="{Binding SelectedSummary}" AutoGenerateColumns="False"
                IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" Margin="0,6,0,0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Estimate #" Binding="{Binding QuoteNumber}" />
          <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt.LocalDateTime, StringFormat=d}" />
          <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
          <DataGridTextColumn Header="Total cost" Binding="{Binding TotalCost, StringFormat=C2, ConverterCulture=en-US}" />
          <DataGridCheckBoxColumn Header="Actuals" Binding="{Binding HasActuals}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
      <!-- Right margin keeps amounts and grids clear of the scroll bar. -->
      <StackPanel Margin="0,0,20,8">
        <TextBlock Text="{Binding EstimateHeader}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Saved cost estimate (later settings changes never alter it)" Style="{StaticResource Hint}" />
        <TextBlock Text="{Binding LegacyNote}" Style="{StaticResource Warning}" TextWrapping="Wrap"
                   Visibility="{Binding LegacyNote, Converter={StaticResource NonEmptyToVis}}" />
        <TextBlock Text="{Binding TeamAndVehicleText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding RouteText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FuelText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />

        <GroupBox Header="Estimated cost" Margin="0,8,0,0">
          <Border BorderBrush="{DynamicResource BorderBrushMuted}" BorderThickness="1" CornerRadius="6" Padding="14,10" MaxWidth="720" HorizontalAlignment="Left">
            <ItemsControl ItemsSource="{Binding CostLines}" Grid.IsSharedSizeScope="True">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid x:Name="Row" Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MinWidth="260" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Amount" MinWidth="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="Label" Text="{Binding Label}" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,0,16,0"
                                 Visibility="{Binding Detail, Converter={StaticResource NonEmptyToVis}}" />
                    </StackPanel>
                    <TextBlock x:Name="Amount" Grid.Column="1" Text="{Binding Amount}" TextAlignment="Right" HorizontalAlignment="Right" />
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Label}" Value="Total estimated cost">
                      <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                      <Setter TargetName="Amount" Property="FontWeight" Value="Bold" />
                      <Setter TargetName="Row" Property="Margin" Value="0,8,0,0" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </GroupBox>
        <StackPanel Orientation="Horizontal">
          <Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding CanEdit}" FontWeight="SemiBold"
                  ToolTip="Open this estimate in the New estimate form. Saving updates it and keeps the previous version." />
          <Button Content="Delete" Command="{Binding DeleteCommand}" />
          <Button Content="Copy saved estimate" Command="{Binding CopySavedEstimateCommand}" />
        </StackPanel>

        <GroupBox Header="Actuals">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Actual trip miles (total)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Text="{Binding ActualMilesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual trip miles" />
            <TextBlock Grid.Row="1" Text="Actual driving (total)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActualDriveHoursText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual drive hours" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="h" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ActualDriveMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual drive minutes" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="min" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="2" Text="Actual installation" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ActualInstallHoursText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual installation hours" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="h" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ActualInstallMinutesText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual installation minutes" />
            <TextBlock Grid.Row="2" Grid.Column="4" Text="min" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="3" Text="Paid team hours" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ActualPaidHoursText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Paid team hours" />
            <TextBlock Grid.Row="4" Text="Actual labor cost override ($)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ActualLaborCostText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual labor cost override" />
            <TextBlock Grid.Row="5" Text="Actual fuel cost ($, if known)" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ActualFuelCostText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual fuel cost" />
            <StackPanel Grid.Row="6" Grid.ColumnSpan="5">
              <CheckBox Content="Record actual other direct costs (unchecked = assume the estimated amounts)" IsChecked="{Binding OtherCostsRecorded}" Margin="0,6,0,2" />
              <ItemsControl ItemsSource="{Binding ActualOtherCosts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBox Width="240" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual cost description" />
                      <TextBox Width="90" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual cost amount" />
                      <Button Content="Remove" MinWidth="60"
                              Command="{Binding DataContext.RemoveActualCostCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Add actual cost" Command="{Binding AddActualCostCommand}" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Row="7" Grid.ColumnSpan="5">
              <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" />
              <TextBox Text="{Binding ActualNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Actual notes" AcceptsReturn="True" MinHeight="40" TextWrapping="Wrap" />
              <Button Content="Save actuals" Command="{Binding SaveActualsCommand}" HorizontalAlignment="Left" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Header="Estimated vs actual cost">
          <StackPanel>
            <DataGrid ItemsSource="{Binding Comparison}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      MaxWidth="720" HorizontalAlignment="Left" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False">
              <DataGrid.Resources>
                <Style x:Key="AmountCell" TargetType="TextBlock">
                  <Setter Property="TextAlignment" Value="Right" />
                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="8,4,12,4" />
                </Style>
                <Style x:Key="LabelCell" TargetType="TextBlock">
                  <Setter Property="Padding" Value="8,4" />
                </Style>
                <Style x:Key="AmountHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="HorizontalContentAlignment" Value="Right" />
                  <Setter Property="Padding" Value="8,4,12,4" />
                </Style>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Cost" Binding="{Binding Label}" Width="*" MinWidth="200" ElementStyle="{StaticResource LabelCell}" />
                <DataGridTextColumn Header="Estimated" Binding="{Binding Estimated}" Width="120" ElementStyle="{StaticResource AmountCell}" HeaderStyle="{StaticResource AmountHeader}" />
                <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="120" ElementStyle="{StaticResource AmountCell}" HeaderStyle="{StaticResource AmountHeader}" />
                <DataGridTextColumn Header="Variance" Binding="{Binding Variance}" Width="120" ElementStyle="{StaticResource AmountCell}" HeaderStyle="{StaticResource AmountHeader}" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Assumptions used for actuals:" FontWeight="SemiBold" Margin="0,6,0,0"
                       Visibility="{Binding Assumptions, Converter={StaticResource NonEmptyToVis}}" />
            <ItemsControl ItemsSource="{Binding Assumptions}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource Hint}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Issues}">
              <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat=Missing: {0}}" Style="{StaticResource Warning}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
