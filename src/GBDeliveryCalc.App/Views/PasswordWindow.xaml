<Window x:Class="GBDeliveryCalc.App.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <StackPanel Margin="20">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />
    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
    <PasswordBox x:Name="PasswordBox1" AutomationProperties.Name="Password" />
    <StackPanel x:Name="ConfirmPanel">
      <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" />
      <PasswordBox x:Name="PasswordBox2" AutomationProperties.Name="Confirm password" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Style="{StaticResource Warning}" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" Margin="0,4,0,4" />
    </StackPanel>
  </StackPanel>
</Window>
