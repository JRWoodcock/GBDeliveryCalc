<Window x:Class="GBDeliveryCalc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GBDeliveryCalc.App.Views"
        Title="GB DeliveryCalc"
        Width="1280" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <TabControl SelectedIndex="{Binding SelectedTab}" Margin="6">
    <TabItem Header="New estimate">
      <views:NewEstimateView DataContext="{Binding NewEstimate}" />
    </TabItem>
    <TabItem Header="History &amp; actuals">
      <views:HistoryView DataContext="{Binding History}" />
    </TabItem>
    <TabItem Header="Settings">
      <views:SettingsView DataContext="{Binding Settings}" />
    </TabItem>
  </TabControl>
</Window>
