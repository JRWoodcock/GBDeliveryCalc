<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App colours for the light theme. Standard controls are themed by WPF's Fluent theme (Application.ThemeMode).
       Text colours meet WCAG AA (4.5:1) on the window background. -->
  <SolidColorBrush x:Key="HintBrush" Color="#4B5563" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9A3412" />
  <SolidColorBrush x:Key="StatusBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF7ED" />
  <SolidColorBrush x:Key="NoticeBorderBrush" Color="#FDBA74" />
  <SolidColorBrush x:Key="NoticeTextBrush" Color="#9A3412" />
  <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EFF6FF" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#93C5FD" />
  <SolidColorBrush x:Key="InfoTextBrush" Color="#1D4ED8" />

  <!-- Selected DataGrid rows: fixed colours so the text stays readable whatever the Windows accent colour is. -->
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#BFDBFE" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#0F172A" />

  <!-- About and License windows -->
  <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F9FAFB" />
  <SolidColorBrush x:Key="BorderBrushMuted" Color="#D1D5DB" />
  <SolidColorBrush x:Key="AccentBrush" Color="#1E3A8A" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#4B5563" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#374151" />
</ResourceDictionary>
