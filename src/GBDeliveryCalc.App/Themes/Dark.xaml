<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- App colours for the dark theme. Standard controls are themed by WPF's Fluent theme (Application.ThemeMode).
       Text colours meet WCAG AA (4.5:1) on the dark window and banner backgrounds. -->
  <SolidColorBrush x:Key="HintBrush" Color="#C4C9D1" />
  <SolidColorBrush x:Key="WarningBrush" Color="#FDBA74" />
  <SolidColorBrush x:Key="StatusBrush" Color="#93C5FD" />
  <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#3A2412" />
  <SolidColorBrush x:Key="NoticeBorderBrush" Color="#C2410C" />
  <SolidColorBrush x:Key="NoticeTextBrush" Color="#FED7AA" />
  <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#172554" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="InfoTextBrush" Color="#BFDBFE" />

  <!-- Selected DataGrid rows: fixed colours so the text stays readable whatever the Windows accent colour is. -->
  <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#1E40AF" />
  <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF" />

  <!-- About and License windows -->
  <SolidColorBrush x:Key="WindowBrush" Color="#1B1B1F" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="#26262B" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#202024" />
  <SolidColorBrush x:Key="BorderBrushMuted" Color="#3F3F46" />
  <SolidColorBrush x:Key="AccentBrush" Color="#1E3A8A" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#B4B9C2" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D4D7DD" />
</ResourceDictionary>
