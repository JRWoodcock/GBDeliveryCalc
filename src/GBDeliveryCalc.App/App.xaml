<Application x:Class="GBDeliveryCalc.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:GBDeliveryCalc.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <infra:InverseBoolConverter x:Key="InverseBool" />
    <infra:EnumLabelConverter x:Key="EnumLabel" />
    <infra:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />

    <Style TargetType="TextBlock" x:Key="FieldLabel">
      <Setter Property="Margin" Value="0,6,8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="Foreground" Value="{DynamicResource HintBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
    <Style TargetType="TextBlock" x:Key="Warning">
      <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
    <!-- Implicit TextBox, ComboBox, Button and GroupBox spacing is added in ThemeService, based on the Fluent styles. -->
  </Application.Resources>
</Application>
